# Sanity — get these from sanity.io/manage after creating your project
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Needed only for write operations (migrations, webhooks)
SANITY_API_TOKEN=your_token_here

# Optional: Sanity Preview secret for draft content
SANITY_REVALIDATE_SECRET=your_revalidate_secret
