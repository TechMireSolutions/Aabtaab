# Sanity (required)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# On-demand revalidation webhook
SANITY_REVALIDATE_SECRET=

# Public site URL (canonical links, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://aabtaab.com

# Contact form email (optional — submissions still save to Sanity)
# Prefer Resend:
RESEND_API_KEY=
EMAIL_FROM=Aabtaab Contact <notifications@yourdomain.com>
EMAIL_TO=
# Gmail SMTP fallback (if RESEND_API_KEY unset):
EMAIL_USER=
EMAIL_PASS=

# Google Search Console (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sanity draft/preview (optional — requires SANITY_API_TOKEN with read access)
SANITY_PREVIEW_SECRET=

# Error monitoring (optional — production only when set)
NEXT_PUBLIC_SENTRY_DSN=

# Contact form rate limiting (optional — falls back to in-memory on single server)
# When behind Cloudflare, cf-connecting-ip is used automatically for rate limits.
UPSTASH_REDIS_REST_URL=
# Cloudflare Turnstile spam protection (optional — verification is skipped if unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Run after deploying schema/field renames (see package.json migrate:sanity scripts):
# npm run migrate:sanity:dry
# npm run migrate:sanity
